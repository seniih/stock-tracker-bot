# BotFather'dan aldığın Telegram bot token'ı (zorunlu)
TELEGRAM_BOT_TOKEN=

# Veritabanı bağlantısı.
# Yerelde: sqlite. Bulutta (Railway/Fly): postgresql+psycopg://...
DB_URL=sqlite:///stock_tracker.db

# Poll aralığı (dakika). Sitelere kibar olmak için 5'in altına inme.
POLL_INTERVAL_MINUTES=30

# Kullanıcı başına maksimum takip sayısı. Bot herkese açık olduğu için,
# tek bir kullanıcının poller yükünü (ve mağazalara giden istekleri) sınırsız
# büyütmesini engeller.
MAX_SUBSCRIPTIONS_PER_USER=20
